# SafePass — live SMS/USSD configuration
# Copy to .env and fill in your Africa's Talking credentials

SECRET_KEY=generate-a-strong-random-secret
DATABASE_URL=sqlite:///./safepass.db
ACCESS_TOKEN_EXPIRE_MINUTES=480

SEED_ON_STARTUP=false

# ── LIVE Africa's Talking (Option B — physical phone) ──
# Account: https://account.africastalking.com  (NOT sandbox)
# Email template: backend/at_live_request_email.txt

SMS_PROVIDER=africas_talking
WHATSAPP_PROVIDER=africas_talking
VOICE_PROVIDER=africas_talking
AIRTIME_PROVIDER=africas_talking
AT_USERNAME=your_live_app_username
AT_API_KEY=your_live_api_key
SMS_SENDER_ID=SAFEPASS
WHATSAPP_SENDER_ID=SAFEPASS
AT_VOICE_PHONE=+26377xxxxxxx
VOICE_ENABLED=true
AIRTIME_ENABLED=true
AIRTIME_CURRENCY=USD
AIRTIME_AMOUNT=0.20

# Public HTTPS URL (no trailing slash) — ngrok, Marketplace instance, or deployed server
# Register USSD: {PUBLIC_API_URL}/ussd/callback
# Register Voice: {PUBLIC_API_URL}/voice/callback
PUBLIC_API_URL=https://your-api-domain.com

# Assigned by Africa's Talking after support request
USSD_SERVICE_CODE=*123#

# Optional — reject unsigned USSD JSON callbacks when set
USSD_CALLBACK_SECRET=

CORS_ORIGINS=http://localhost:5173,https://your-production-domain.com

EDD_REMINDER_ENABLED=true
EDD_REMINDER_INTERVAL_HOURS=6
FOLLOW_UP_REMINDER_ENABLED=true
EDUCATION_ENABLED=true

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
AI_ENABLED=true

RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=20

# Automated tests only — do not use in production
# SMS_PROVIDER=log
# WHATSAPP_PROVIDER=log
